from machine import ADC, Pin, Timer
import utime

# ---------- Pin & Hardware Configuration ----------
ADC_PIN = const(26)           # GP26 / ADC0 (shared 0.1 ohm sense resistor path)

VREF = 3.3
ADC_MAX = 65535
VOLTS_PER_ADC = VREF / ADC_MAX
RSENSE = 0.10                 # Ohms (shared motor return sense resistor)

SAMPLES = const(32)
SAMPLE_INTERVAL_US = const(500)
POLL_PERIOD_MS = const(100)
CHANGE_THRESHOLD = const(150)

# Calibrated ADC thresholds for ~1.8 A per motor across 0.10 ohm shunt:
# 0 A    -> ~0
# 1.8 A  -> ~3575 (0.18 V)
# 3.6 A  -> ~7149 (0.36 V)
OFF_LIMIT = const(500)        # ~0.25 A cutoff
SINGLE_LIMIT = const(5360)    # Midpoint between 1.8 A (~3575) and 3.6 A (~7149)

adc = ADC(Pin(ADC_PIN))
sample_due = False


def on_tick(_timer):
    global sample_due
    sample_due = True


def read_adc_average():
    total = 0
    last_sample_us = utime.ticks_us()
    count = 0

    while count < SAMPLES:
        now_us = utime.ticks_us()
        if utime.ticks_diff(now_us, last_sample_us) >= SAMPLE_INTERVAL_US:
            last_sample_us = now_us
            total += adc.read_u16()
            count += 1

    return total // SAMPLES


def identify_state(adc_value):
    if adc_value < OFF_LIMIT:
        return "BOTH OFF"
    if adc_value < SINGLE_LIMIT:
        return "ONE MOTOR ON (~1.8A)"
    return "TWO MOTORS ON (~3.6A)"


def print_reading(adc_value):
    sense_voltage = adc_value * VOLTS_PER_ADC
    current = sense_voltage / RSENSE
    state = identify_state(adc_value)

    print(
        "State:", state,
        "| ADC:", adc_value,
        "| Vsense: {:.4f} V".format(sense_voltage),
        "| Current: {:.3f} A".format(current),
    )
    return state


timer = Timer(-1)
timer.init(mode=Timer.PERIODIC, period=POLL_PERIOD_MS, callback=on_tick)

# Initial baseline reading
last_adc = read_adc_average()
last_state = print_reading(last_adc)

try:
    while True:
        if sample_due:
            sample_due = False
            adc_value = read_adc_average()
            curr_state = identify_state(adc_value)

            if curr_state != last_state or abs(adc_value - last_adc) >= CHANGE_THRESHOLD:
                last_state = print_reading(adc_value)
                last_adc = adc_value
finally:
    timer.deinit()
